# Skopiuj ten plik do .env i uzupełnij danymi ze swojego projektu Supabase
# (Supabase Dashboard -> Project Settings -> API)

VITE_SUPABASE_URL=https://twoj-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=twoj-anon-public-key

# Powiadomienia o rundzie (ADR-0004). Klucz publiczny VAPID — ten sam co
# VAPID_PUBLIC_KEY w sekretach funkcji notify-round. Bez niego przycisk
# powiadomień się nie pokazuje. Para kluczy: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
